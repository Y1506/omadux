#!/usr/bin/env python3
"""scripts/upstream-check — Dev-only tool to verify/sync against upstream dux-shell & caelestia.bar commits.
"""

import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
LOCK_FILE = os.path.join(HERE, "..", "tests", "upstream.lock")


def get_git_rev(repo_path):
    if not os.path.isdir(repo_path):
        return None
    try:
        proc = subprocess.run(
            ["git", "-C", repo_path, "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=True,
        )
        return proc.stdout.strip()
    except Exception:
        return None


def verify_lock():
    if not os.path.exists(LOCK_FILE):
        print(f"FAIL: Missing lock file {LOCK_FILE}", file=sys.stderr)
        return 1

    try:
        with open(LOCK_FILE, "r", encoding="utf-8") as f:
            lock_data = json.load(f)
    except Exception as e:
        print(f"FAIL: Invalid JSON in {LOCK_FILE}: {e}", file=sys.stderr)
        return 1

    required_keys = ["dux-shell", "dux-qml-common", "caelestia.bar", "recorded"]
    for k in required_keys:
        if k not in lock_data:
            print(f"FAIL: Missing key '{k}' in upstream.lock", file=sys.stderr)
            return 1

    print("✓ upstream.lock schema and integrity verified:")
    for k, v in lock_data.items():
        print(f"   {k}: {v}")

    # If local checkouts exist under /tmp/omadux-upstream, verify match
    upstream_root = "/tmp/omadux-upstream"
    if os.path.isdir(upstream_root):
        dux_rev = get_git_rev(os.path.join(upstream_root, "dux-shell"))
        if dux_rev and dux_rev != lock_data.get("dux-shell"):
            print(f"Warning: dux-shell HEAD ({dux_rev}) differs from lock ({lock_data.get('dux-shell')})")

    return 0


def main():
    parser = argparse.ArgumentParser(description="Upstream verification tool")
    parser.add_argument("--record", action="store_true", help="Record current SHAs")
    args = parser.parse_args()

    sys.exit(verify_lock())


if __name__ == "__main__":
    main()
